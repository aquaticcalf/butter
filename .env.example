# Required
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Model provider API keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Storage
BUTTER_DB_PATH=./butter.db

# Optional: Telegram adapter config
# TELEGRAM_PROXY_URL=http://proxy:8080
# TELEGRAM_WEBHOOK_URL=https://example.com/webhook
# TELEGRAM_WEBHOOK_SECRET=mysecret
# TELEGRAM_ALLOWED_CHAT_TYPES=private,group,supergroup
# TELEGRAM_ALLOWED_GROUP_IDS=123456,-789012
# TELEGRAM_GUEST_MODE=false
# TELEGRAM_REQUIRE_MENTION=true
# TELEGRAM_ERROR_ALERT_CHAT_ID=123456
