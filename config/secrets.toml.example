# Secrets configuration template
# Copy to secrets.toml and fill in values, or use environment variables.
# API keys are loaded from environment variables by default.

# Required
telegram_bot_token = "${TELEGRAM_BOT_TOKEN}"

# Model provider API keys (at least one required)
anthropic_api_key = "${ANTHROPIC_API_KEY}"
openai_api_key = "${OPENAI_API_KEY}"
gemini_api_key = "${GEMINI_API_KEY}"
